(module OvalPadTest (layer F.Cu)
  (descr "Test fixture for oval pads")
  (pad 1 thru_hole oval (at 0 0) (size 1 1.6) (drill oval 0.6 1.2) (layers *.Cu *.Mask))
  (pad 2 thru_hole oval (at 3 0 90) (size 1 1.6) (drill oval 0.6 1.2) (layers *.Cu *.Mask))
  (pad 3 smd oval (at 0 3) (size 1.2 0.8) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd circle (at 3 3) (size 1 1) (layers F.Cu F.Paste F.Mask))
)
